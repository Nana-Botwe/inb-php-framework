# =============================================================================
#  INB PHP Framework — PRODUCTION settings template
#  Copy to .env ON THE SERVER (never commit it), fill in every value, then run:
#     php console key:generate        (once, on first deploy)
#     php console security:check      (must report no HIGH problems)
#     php console security:scan       (after the site is live)
# =============================================================================

APP_NAME="INB PHP Framework"
APP_ENV=production
APP_DEBUG=false
# Canonical public address — REQUIRED in production (email links, trusted-host check).
APP_URL=https://www.example.com
APP_TIMEZONE=Africa/Accra
APP_LOCALE=en
APP_KEY=
# Old keys after "php console key:rotate" (comma separated, newest first)
APP_PREVIOUS_KEYS=

# Extra host names this site answers to (comma separated). Empty = only the host of APP_URL.
TRUSTED_HOSTS=
# IPs/CIDRs of YOUR load balancer / Cloudflare, only if you are behind one.
TRUSTED_PROXIES=

# ---------------------------------------------------------------- database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
# A dedicated user with rights on this database only — never root.
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------- sessions & auth
SESSION_DRIVER=file
SESSION_NAME=inb_session
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=720
SESSION_SECURE_COOKIE=true
AUTH_VERIFY_EMAIL=true
AUTH_2FA_REQUIRED_ROLES=admin
AUTH_TOKEN_DAYS=90
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- several app servers?
# Use shared stores so sessions, rate limits and cache work across servers:
#   SESSION_DRIVER=database  RATE_LIMIT_STORE=database  CACHE_STORE=database
RATE_LIMIT_STORE=file
CACHE_STORE=file

# ---------------------------------------------------------------- mail (never "log" in production)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="INB PHP Framework"
MAIL_THEME=modern

# ---------------------------------------------------------------- background work
QUEUE_CONNECTION=database

# ---------------------------------------------------------------- operations
LOG_ALERT_EMAIL=
LOG_RETENTION_DAYS=30
LOG_SENSITIVE_RETENTION_DAYS=3
BACKUP_SCHEDULE=true
BACKUP_KEEP=14
# Separate EMPTY database for "php console deploy:verify --restore-test=restore_test" (name must contain "restore" or "test")
DB_RESTORE_TEST_URL=
DOCS_ENABLED=false

# ---------------------------------------------------------------- integrations
PAYMENT_GATEWAY=
PAYMENT_CURRENCY=GHS
SMS_GATEWAY=log
