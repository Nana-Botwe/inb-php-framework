# =============================================================================
#  INB PHP Framework — environment settings
#  Copy to .env and fill in. NEVER commit .env or share it: it holds your secrets.
# =============================================================================

APP_NAME="INB PHP Framework"
# local | staging | production
APP_ENV=local
# MUST be false on a live server
APP_DEBUG=true
# Public URL (used in emails and by the CLI), e.g. https://inbitfirm.com
APP_URL=http://localhost
APP_TIMEZONE=Africa/Accra
APP_LOCALE=en
# Generate with: php console key:generate
APP_KEY=

# ---------------------------------------------------------------- database
# mysql | mariadb | pgsql | sqlite | sqlsrv | oracle | firebird | odbc   (php console db:drivers)
DB_CONNECTION=mysql
# Or a single URL instead of the values below, e.g. postgres://user:pass@host:5432/db
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inb_app
# Use a dedicated user with rights on this database only — never root.
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------- sessions & auth
SESSION_NAME=inb_session
SESSION_LIFETIME=120
# true on HTTPS sites
SESSION_SECURE_COOKIE=false
AUTH_VERIFY_EMAIL=true
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- security
FIREWALL_ENABLED=true
# Front-end origins allowed to call /api from a browser (comma separated)
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- mail
# log | smtp
MAIL_MAILER=log
# modern | classic | minimal   (php console mail:theme classic)
MAIL_THEME=modern
MAIL_BRAND_COLOR="#e11d48"
MAIL_COMPANY="INB IT Firm"
MAIL_COMPANY_ADDRESS="Accra, Ghana"
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="INB PHP Framework"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# tls (587) | ssl (465)
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------- queues & uploads
# sync | database
QUEUE_CONNECTION=sync
UPLOAD_MAX_KB=10240
UPLOAD_COMPRESS=true
# auto | zstd | brotli | gzip
UPLOAD_ALGORITHM=auto
# webp | jpg | png | original
UPLOAD_IMAGE_FORMAT=webp

# ---------------------------------------------------------------- payments
# Choose with: php console payment:install paystack|flutterwave|stripe|paypal|hubtel
PAYMENT_GATEWAY=
PAYMENT_CURRENCY=GHS

# ---------------------------------------------------------------- SMS
# Choose with: php console sms:install twilio|africastalking|hubtel|arkesel
SMS_GATEWAY=log
SMS_COUNTRY_CODE=233
SMS_HOURLY_LIMIT=10

# ---------------------------------------------------------------- hardening (see .env.production.example)
APP_PREVIOUS_KEYS=
TRUSTED_HOSTS=
TRUSTED_PROXIES=
SESSION_DRIVER=file
SESSION_ABSOLUTE_LIFETIME=720
RATE_LIMIT_STORE=file
CACHE_STORE=file
AUTH_2FA_REQUIRED_ROLES=admin
LOG_ALERT_EMAIL=
BACKUP_SCHEDULE=false
